"""Regression test: SQL injection must not leak canary data."""

import pytest
from target.vuln_app.app import app

CANARY = "{{ canary }}"

PAYLOADS = [
{%- for payload in payloads %}
    {{ payload | tojson }},
{%- endfor %}
]


@pytest.fixture
def client():
    """Create a test client for the vulnerable app."""
    app.config["TESTING"] = True
    with app.test_client() as c:
        yield c


@pytest.mark.parametrize("payload", PAYLOADS)
def test_{{ param }}_does_not_leak_secret_row(client, payload):
    """The search endpoint must not return the canary row for any payload."""
    r = client.{{ method }}("{{ route }}", query_string={"{{ param }}": payload})
    body = r.get_data(as_text=True)
    assert CANARY not in body, f"Canary leaked with payload: {payload}"
