<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>PatchProof — Security Rules That Generate Regression Tests</title>
    <style>
        :root {
            --bg: #070b14;
            --surface: #0f172a;
            --surface-card: #141f36;
            --surface-hover: #1e2c4a;
            --border: #22324e;
            --border-light: #32476d;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --text-dim: #64748b;
            --accent-blue: #38bdf8;
            --accent-cyan: #06b6d4;
            --accent-green: #10b981;
            --accent-red: #f43f5e;
            --accent-amber: #f59e0b;
            --accent-purple: #a855f7;
            --accent-indigo: #6366f1;
            --code-bg: #030712;
        }

        html.light {
            --bg: #f8fafc;
            --surface: #ffffff;
            --surface-card: #f1f5f9;
            --surface-hover: #e2e8f0;
            --border: #cbd5e1;
            --border-light: #94a3b8;
            --text-main: #0f172a;
            --text-muted: #475569;
            --text-dim: #64748b;
            --accent-blue: #0284c7;
            --accent-cyan: #0891b2;
            --accent-green: #059669;
            --accent-red: #e11d48;
            --accent-amber: #d97706;
            --accent-purple: #7c3aed;
            --accent-indigo: #4f46e5;
            --code-bg: #0f172a;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; transition: background-color 0.2s, border-color 0.2s; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background: var(--bg);
            color: var(--text-main);
            min-height: 100vh;
            line-height: 1.5;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* Top Navigation Header */
        header {
            background: rgba(15, 23, 42, 0.92);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(12px);
        }
        .nav-container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 0.85rem 1.75rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
        }
        .brand {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            text-decoration: none;
            color: var(--text-main);
            cursor: pointer;
        }
        .brand-badge {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: linear-gradient(135deg, #0284c7, #6366f1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            box-shadow: 0 0 15px rgba(2, 132, 199, 0.4);
        }
        .brand-text h1 {
            font-size: 1.25rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            background: linear-gradient(90deg, #38bdf8, #818cf8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .brand-text p {
            font-size: 0.72rem;
            color: var(--text-muted);
            font-weight: 500;
        }

        /* Nav Tabs */
        .nav-tabs {
            display: flex;
            gap: 0.35rem;
            background: var(--bg);
            padding: 0.3rem;
            border-radius: 10px;
            border: 1px solid var(--border);
        }
        .tab-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            padding: 0.5rem 1rem;
            border-radius: 7px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.45rem;
            white-space: nowrap;
        }
        .tab-btn:hover {
            color: var(--text-main);
            background: var(--surface-hover);
        }
        .tab-btn.active {
            background: var(--surface-card);
            color: var(--accent-blue);
            box-shadow: 0 1px 4px rgba(0,0,0,0.3);
            border: 1px solid var(--border);
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        .btn-action {
            padding: 0.45rem 0.9rem;
            border-radius: 7px;
            font-size: 0.8rem;
            font-weight: 600;
            border: 1px solid var(--border);
            background: var(--surface-card);
            color: var(--text-main);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }
        .btn-action:hover {
            background: var(--surface-hover);
            border-color: var(--accent-blue);
        }
        .btn-primary {
            background: linear-gradient(135deg, #0284c7, #3b82f6);
            color: white;
            border: none;
            box-shadow: 0 0 12px rgba(2, 132, 199, 0.4);
        }
        .btn-primary:hover {
            opacity: 0.95;
            box-shadow: 0 0 18px rgba(2, 132, 199, 0.6);
        }
        .theme-toggle {
            cursor: pointer;
            font-size: 1.1rem;
            padding: 0.45rem 0.65rem;
            border-radius: 7px;
            border: 1px solid var(--border);
            background: var(--surface-card);
            color: var(--text-main);
        }

        /* Main Container */
        main {
            max-width: 1440px;
            width: 100%;
            margin: 0 auto;
            padding: 2rem 1.75rem 4rem;
            flex: 1;
        }

        /* View Panels */
        .view-panel {
            display: none;
        }
        .view-panel.active {
            display: block;
            animation: fadeIn 0.25s ease-in-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Hero Banner */
        .hero-banner {
            background: radial-gradient(circle at 50% 0%, rgba(56, 189, 248, 0.12) 0%, rgba(15, 23, 42, 0.4) 60%), var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 2.25rem 2rem;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 25px rgba(0, 0, 0, 0.3);
        }
        .hero-banner::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--accent-blue), transparent);
        }
        .hero-tagline-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(56, 189, 248, 0.1);
            border: 1px solid rgba(56, 189, 248, 0.3);
            color: var(--accent-blue);
            font-size: 0.8rem;
            font-weight: 700;
            padding: 0.35rem 0.85rem;
            border-radius: 9999px;
            margin-bottom: 1rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .hero-title {
            font-size: 2.2rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            line-height: 1.25;
            margin-bottom: 0.75rem;
            max-width: 900px;
        }
        .hero-title span {
            background: linear-gradient(90deg, #38bdf8, #818cf8, #c084fc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .hero-desc {
            font-size: 1.05rem;
            color: var(--text-muted);
            max-width: 820px;
            line-height: 1.6;
            margin-bottom: 1.5rem;
        }
        .hero-pills {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
        }
        .hero-pill-item {
            background: var(--surface-card);
            border: 1px solid var(--border);
            padding: 0.4rem 0.85rem;
            border-radius: 8px;
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        /* Studio Grid (Editor + Suggestion Drawer) */
        .studio-grid {
            display: grid;
            grid-template-columns: 1.4fr 0.85fr;
            gap: 1.75rem;
            align-items: start;
        }
        @media (max-width: 1080px) {
            .studio-grid { grid-template-columns: 1fr; }
        }

        /* Code Editor Card */
        .editor-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            box-shadow: 0 4px 20px rgba(0,0,0,0.25);
        }
        .editor-toolbar {
            background: var(--surface-card);
            border-bottom: 1px solid var(--border);
            padding: 0.75rem 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 0.75rem;
        }
        .editor-toolbar-title {
            font-size: 0.9rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .editor-presets {
            display: flex;
            gap: 0.4rem;
            flex-wrap: wrap;
        }
        .preset-btn {
            background: var(--surface);
            border: 1px solid var(--border);
            padding: 0.35rem 0.65rem;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-muted);
            cursor: pointer;
        }
        .preset-btn:hover {
            color: var(--accent-blue);
            border-color: var(--accent-blue);
            background: var(--surface-hover);
        }

        /* Drag & Drop Upload Strip */
        .upload-strip {
            background: rgba(3, 7, 18, 0.4);
            border-bottom: 1px dashed var(--border);
            padding: 0.85rem 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.85rem;
            cursor: pointer;
        }
        .upload-strip:hover {
            background: rgba(56, 189, 248, 0.04);
            border-color: var(--accent-blue);
        }
        .upload-strip input[type="file"] { display: none; }

        /* Code Area (Huge Context Window) */
        .code-input-wrapper {
            position: relative;
            background: var(--code-bg);
            min-height: 480px;
        }
        .code-textarea {
            width: 100%;
            height: 480px;
            background: transparent;
            color: #e2e8f0;
            border: none;
            outline: none;
            padding: 1.25rem;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.88rem;
            line-height: 1.6;
            resize: vertical;
            tab-size: 4;
            white-space: pre;
            overflow-wrap: normal;
            overflow-x: auto;
        }
        .editor-statusbar {
            background: var(--surface-card);
            border-top: 1px solid var(--border);
            padding: 0.6rem 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.78rem;
            color: var(--text-dim);
            font-family: ui-monospace, monospace;
        }
        .editor-launch-bar {
            padding: 1rem 1.25rem;
            background: var(--surface);
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }
        .btn-launch-large {
            padding: 0.85rem 1.75rem;
            border-radius: 9px;
            font-size: 0.95rem;
            font-weight: 800;
            background: linear-gradient(135deg, #0284c7, #3b82f6, #6366f1);
            color: white;
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            box-shadow: 0 0 20px rgba(56, 189, 248, 0.35);
        }
        .btn-launch-large:hover {
            opacity: 0.95;
            box-shadow: 0 0 28px rgba(56, 189, 248, 0.55);
            transform: translateY(-1px);
        }

        /* Suggestion & Security Toolbox */
        .toolbox-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
            padding: 1.25rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.25);
        }
        .toolbox-header {
            border-bottom: 1px solid var(--border);
            padding-bottom: 0.75rem;
        }
        .toolbox-header h3 {
            font-size: 1.05rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .toolbox-header p {
            font-size: 0.78rem;
            color: var(--text-muted);
            margin-top: 0.2rem;
        }

        .rule-card {
            background: var(--surface-card);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 0.85rem;
            transition: border-color 0.2s;
        }
        .rule-card.detected {
            border-color: var(--accent-red);
            background: rgba(244, 63, 94, 0.05);
        }
        .rule-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 0.35rem;
        }
        .rule-name {
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--text-main);
        }
        .rule-desc {
            font-size: 0.75rem;
            color: var(--text-muted);
            line-height: 1.4;
        }

        .suggestion-box {
            background: rgba(56, 189, 248, 0.05);
            border: 1px solid rgba(56, 189, 248, 0.2);
            border-radius: 8px;
            padding: 0.85rem;
        }
        .suggestion-box h4 {
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--accent-blue);
            margin-bottom: 0.35rem;
            display: flex;
            align-items: center;
            gap: 0.35rem;
        }
        .suggestion-box p {
            font-size: 0.75rem;
            color: var(--text-muted);
            line-height: 1.45;
        }

        /* Motion Stepper Panel */
        .motion-panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 2rem;
            box-shadow: 0 4px 25px rgba(0,0,0,0.3);
        }
        .motion-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2rem;
            padding-bottom: 1.25rem;
            border-bottom: 1px solid var(--border);
        }
        .motion-title h2 {
            font-size: 1.5rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }
        .motion-title p {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-top: 0.2rem;
        }

        .motion-stepper {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 0.75rem;
            margin-bottom: 2rem;
        }
        @media (max-width: 900px) {
            .motion-stepper { grid-template-columns: 1fr; }
        }
        .m-step {
            background: var(--surface-card);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 1rem 0.6rem;
            text-align: center;
            position: relative;
            transition: all 0.3s;
        }
        .m-step.active {
            border-color: var(--accent-blue);
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.3);
            background: rgba(56, 189, 248, 0.08);
            transform: scale(1.03);
        }
        .m-step.done {
            border-color: var(--accent-green);
            background: rgba(16, 185, 129, 0.06);
        }
        .m-step-icon {
            font-size: 1.3rem;
            margin-bottom: 0.3rem;
        }
        .m-step-name {
            font-size: 0.85rem;
            font-weight: 700;
        }
        .m-step-badge {
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--text-dim);
            margin-top: 0.2rem;
        }
        .m-step.active .m-step-badge { color: var(--accent-blue); }
        .m-step.done .m-step-badge { color: var(--accent-green); }

        .motion-console-card {
            background: #040711;
            border: 1px solid #1e293b;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 1.5rem;
        }
        .console-topbar {
            background: #0f172a;
            padding: 0.6rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #1e293b;
        }
        .console-stream {
            padding: 1.25rem;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.83rem;
            color: #cbd5e1;
            min-height: 280px;
            max-height: 380px;
            overflow-y: auto;
            line-height: 1.6;
            white-space: pre-wrap;
        }

        .motion-completion-card {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(6, 182, 212, 0.12));
            border: 1px solid var(--accent-green);
            border-radius: 12px;
            padding: 1.5rem 2rem;
            display: none;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
            animation: fadeIn 0.3s;
        }

        /* KPI Grid */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 1.25rem;
            margin-bottom: 2rem;
        }
        .kpi-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1.25rem 1.5rem;
            position: relative;
            overflow: hidden;
        }
        .kpi-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--accent-blue);
        }
        .kpi-card.green::before { background: var(--accent-green); }
        .kpi-card.red::before { background: var(--accent-red); }
        .kpi-card.amber::before { background: var(--accent-amber); }
        .kpi-card.purple::before { background: var(--accent-purple); }

        .kpi-label {
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .kpi-val {
            font-size: 2rem;
            font-weight: 800;
            color: var(--text-main);
            letter-spacing: -0.02em;
            line-height: 1;
        }
        .kpi-sub {
            font-size: 0.78rem;
            color: var(--text-dim);
            margin-top: 0.5rem;
        }

        .card-panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            margin-bottom: 2rem;
            overflow: hidden;
        }
        .panel-header {
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--surface-card);
        }
        .panel-header h2 {
            font-size: 1.15rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }
        .search-box {
            background: var(--bg);
            border: 1px solid var(--border);
            padding: 0.4rem 0.75rem;
            border-radius: 6px;
            font-size: 0.85rem;
            color: var(--text-main);
            outline: none;
            width: 220px;
        }

        /* Tables & Pills */
        table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
        th {
            background: var(--surface-card);
            text-align: left;
            padding: 0.85rem 1rem;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border);
        }
        td { padding: 1rem; border-bottom: 1px solid var(--border); vertical-align: middle; }
        tr:hover td { background: var(--surface-hover); }

        .pill {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.25rem 0.6rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 700;
            white-space: nowrap;
        }
        .pill-fixed { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
        .pill-fail { background: rgba(244, 63, 94, 0.15); color: #fb7185; border: 1px solid rgba(244, 63, 94, 0.3); }
        .pill-pass { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
        .pill-cwe { background: rgba(56, 189, 248, 0.12); color: var(--accent-blue); border: 1px solid rgba(56, 189, 248, 0.25); font-family: monospace; }
        .pill-tag { background: var(--surface-card); color: var(--text-muted); border: 1px solid var(--border); }

        /* Master-Detail Explorer */
        .explorer-layout {
            display: grid;
            grid-template-columns: 340px 1fr;
            gap: 1.5rem;
            align-items: start;
        }
        @media (max-width: 980px) {
            .explorer-layout { grid-template-columns: 1fr; }
        }
        .vuln-list {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            padding: 0.5rem;
        }
        .vuln-item {
            padding: 1rem;
            border-radius: 8px;
            border: 1px solid transparent;
            cursor: pointer;
            background: var(--surface-card);
            text-align: left;
        }
        .vuln-item:hover { background: var(--surface-hover); border-color: var(--border-light); }
        .vuln-item.selected { background: rgba(56, 189, 248, 0.08); border-color: var(--accent-blue); }
        .vuln-item-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.35rem; }
        .vuln-item-name { font-weight: 700; font-size: 0.95rem; color: var(--text-main); }
        .vuln-item-route { font-size: 0.78rem; font-family: monospace; color: var(--text-muted); }

        .detail-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
        }
        .detail-card-header {
            padding: 1.5rem;
            background: var(--surface-card);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
        }
        .detail-title-group h3 {
            font-size: 1.35rem;
            font-weight: 800;
            margin-bottom: 0.4rem;
        }
        .detail-sub {
            font-size: 0.85rem;
            color: var(--text-muted);
            display: flex;
            gap: 0.75rem;
            align-items: center;
            flex-wrap: wrap;
        }
        .detail-nav-tabs {
            display: flex;
            border-bottom: 1px solid var(--border);
            background: var(--bg);
            padding: 0 1rem;
            gap: 0.25rem;
            overflow-x: auto;
        }
        .detail-tab-btn {
            background: transparent;
            border: none;
            border-bottom: 2px solid transparent;
            padding: 0.85rem 1rem;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-muted);
            cursor: pointer;
            white-space: nowrap;
        }
        .detail-tab-btn:hover { color: var(--text-main); }
        .detail-tab-btn.active {
            color: var(--accent-blue);
            border-bottom-color: var(--accent-blue);
            background: rgba(56, 189, 248, 0.04);
        }
        .detail-tab-pane { display: none; padding: 1.5rem; }
        .detail-tab-pane.active { display: block; }

        pre {
            background: var(--code-bg);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 1rem;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.85rem;
            overflow-x: auto;
            color: #e2e8f0;
            line-height: 1.5;
        }
        .diff-view {
            font-family: ui-monospace, monospace;
            font-size: 0.82rem;
            background: var(--code-bg);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 0.75rem 0;
            overflow-x: auto;
            line-height: 1.45;
        }
        .diff-line { padding: 0.15rem 1rem; white-space: pre-wrap; }
        .diff-add { background: rgba(16, 185, 129, 0.18); color: #6ee7b7; border-left: 3px solid #10b981; }
        .diff-del { background: rgba(244, 63, 94, 0.18); color: #fca5a5; border-left: 3px solid #f43f5e; }
        .diff-hdr { color: #38bdf8; font-weight: 700; }

        .callout {
            border-radius: 8px;
            padding: 1rem 1.25rem;
            margin-bottom: 1.25rem;
            border-left: 4px solid;
            font-size: 0.9rem;
        }
        .callout-info { background: rgba(56, 189, 248, 0.08); border-color: var(--accent-blue); color: var(--text-main); }
        .callout-success { background: rgba(16, 185, 129, 0.08); border-color: var(--accent-green); color: var(--text-main); }
        .callout-danger { background: rgba(244, 63, 94, 0.08); border-color: var(--accent-red); color: var(--text-main); }
        .callout-warning { background: rgba(245, 158, 11, 0.08); border-color: var(--accent-amber); color: var(--text-main); }
        .callout h4 { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.35rem; display: flex; align-items: center; gap: 0.4rem; }

        .trace-card {
            background: var(--surface-card);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 0.75rem;
        }
        .trace-card.source { border-left: 4px solid var(--accent-green); }
        .trace-card.propagation { border-left: 4px solid var(--accent-blue); }
        .trace-card.sink { border-left: 4px solid var(--accent-red); }
        .trace-header { display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: 700; margin-bottom: 0.5rem; text-transform: uppercase; }

        /* Simulator Styles */
        .sim-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
        @media (max-width: 860px) { .sim-grid { grid-template-columns: 1fr; } }
        .form-group { margin-bottom: 1.25rem; }
        .form-label { display: block; font-size: 0.8rem; font-weight: 700; color: var(--text-muted); margin-bottom: 0.4rem; text-transform: uppercase; }
        .form-select, .form-input {
            width: 100%;
            background: var(--surface-card);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 0.6rem 0.85rem;
            font-size: 0.9rem;
            color: var(--text-main);
            outline: none;
        }
        .radio-group { display: flex; gap: 0.75rem; flex-wrap: wrap; }
        .radio-card { flex: 1; min-width: 130px; border: 1px solid var(--border); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: var(--surface-card); text-align: center; }
        .radio-card.active { border-color: var(--accent-blue); background: rgba(56, 189, 248, 0.08); }
        .radio-title { font-weight: 700; font-size: 0.85rem; }
        .radio-desc { font-size: 0.7rem; color: var(--text-muted); margin-top: 0.2rem; }
        .btn-launch-sim {
            width: 100%;
            padding: 0.75rem;
            background: linear-gradient(135deg, #0284c7, #2563eb);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 0.95rem;
            font-weight: 700;
            cursor: pointer;
        }
        .sim-result-card { background: var(--code-bg); border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; min-height: 380px; display: flex; flex-direction: column; justify-content: space-between; }

        footer {
            border-top: 1px solid var(--border);
            padding: 1.5rem;
            text-align: center;
            font-size: 0.85rem;
            color: var(--text-muted);
            background: var(--surface);
        }
    </style>
</head>
<body>

    <!-- Header Navigation -->
    <header>
        <div class="nav-container">
            <a href="#" class="brand" onclick="switchMainTab('studio', document.querySelectorAll('.nav-tabs .tab-btn')[0])">
                <div class="brand-badge">🛡️</div>
                <div class="brand-text">
                    <h1>PatchProof</h1>
                    <p>Security Rules That Generate Regression Tests</p>
                </div>
            </a>

            <div class="nav-tabs">
                <button class="tab-btn active" onclick="switchMainTab('studio', this)">
                    🏠 Code Studio & Upload
                </button>
                <button class="tab-btn" onclick="switchMainTab('motion', this)">
                    ⚡ Real-Time Pipeline
                </button>
                <button class="tab-btn" id="navReportsBtn" onclick="switchMainTab('reports', this)">
                    📊 Report & Evidence (<span id="navFindingsCount">{{ total_findings }}</span>)
                </button>
                <button class="tab-btn" onclick="switchMainTab('simulator', this)">
                    🧪 Attack Simulator
                </button>
                <button class="tab-btn" onclick="switchMainTab('pipeline', this)">
                    ⚙️ Specs
                </button>
            </div>

            <div class="header-actions">
                <button class="btn-action btn-primary" onclick="launchVerificationFlow()">
                    ⚡ Run Closed-Loop
                </button>
                <button class="theme-toggle" onclick="toggleTheme()" title="Toggle Theme">
                    🌓
                </button>
            </div>
        </div>
    </header>

    <main>

        <!-- ====================================================================
             VIEW 1: CODE STUDIO (HOME PAGE WITH HUGE CONTEXT WINDOW & UPLOAD)
             ==================================================================== -->
        <section id="view-studio" class="view-panel active">
            <!-- Hero Banner -->
            <div class="hero-banner">
                <div class="hero-tagline-badge">
                    <span>⚡</span> Closed-Loop Regression Engine
                </div>
                <h2 class="hero-title">
                    A scanner tells you something looks wrong.<br>
                    <span>PatchProof proves it is wrong, proves the fix works, and makes sure it never returns.</span>
                </h2>
                <p class="hero-desc">
                    Upload your application code or paste target handlers below. PatchProof dynamically parses the code, extracts AST entrypoints and tainted dataflows, seeds canary regression tests, executes exploit verification (Red Run), applies tailored atomic patches, and verifies green rescan diffs and mutant sensitivity.
                </p>
                <div class="hero-pills">
                    <div class="hero-pill-item"><span>📡</span> Semgrep Taint Tracking</div>
                    <div class="hero-pill-item"><span>🎯</span> Canary-Seeded Oracles</div>
                    <div class="hero-pill-item"><span>🔴</span> Red-to-Green Proof (Pytest)</div>
                    <div class="hero-pill-item"><span>⚔️</span> Near-Miss Mutation Testing</div>
                    <div class="hero-pill-item"><span>🛡️</span> Zero Regressions Guarantee</div>
                </div>
            </div>

            <!-- Workspace: Code Editor & Suggestion Drawer -->
            <div class="studio-grid">
                <!-- Large Code Context Window -->
                <div class="editor-card">
                    <div class="editor-toolbar">
                        <div class="editor-toolbar-title">
                            <span>📝</span> Target Codebase Context Window
                        </div>
                        <div class="editor-presets">
                            <button class="preset-btn" onclick="loadPreset('full')">⚡ Load Full App (3 CWEs)</button>
                            <button class="preset-btn" onclick="loadPreset('sqli')">🗄️ SQLi Only</button>
                            <button class="preset-btn" onclick="loadPreset('cmdi')">💻 CMDi Only</button>
                            <button class="preset-btn" onclick="loadPreset('pathtraversal')">📁 Traversal Only</button>
                            <button class="preset-btn" onclick="loadPreset('clean')">✨ Clean Code (0 Bugs)</button>
                            <button class="preset-btn" onclick="clearEditor()">🧹 Clear</button>
                        </div>
                    </div>

                    <!-- File Dropzone -->
                    <label class="upload-strip" for="fileUploadInput">
                        <div>
                            <span>📁</span> <strong>Upload target file or drag & drop:</strong> <span style="color: var(--text-muted); font-size: 0.8rem;">Supports .py, .json, .yml, or zip packages</span>
                        </div>
                        <span class="btn-action" style="padding: 0.25rem 0.6rem; font-size: 0.75rem;">Browse File</span>
                        <input type="file" id="fileUploadInput" onchange="handleFileUpload(event)">
                    </label>

                    <!-- Textarea Code Input -->
                    <div class="code-input-wrapper">
                        <textarea class="code-textarea" id="codeInputArea" spellcheck="false" oninput="onCodeInputChanged()"></textarea>
                    </div>

                    <div class="editor-statusbar">
                        <div id="editorStats">Lines: 106 | Characters: 3,421 | Framework: Flask/Python | Context Size: 3.4 KB</div>
                        <div id="editorAnalysisStatus" style="color: var(--accent-blue);">● Ready for Analysis</div>
                    </div>

                    <div class="editor-launch-bar">
                        <div style="font-size: 0.85rem; color: var(--text-muted);" id="editorAnalysisSummary">
                            🚀 Ready to trigger Semgrep taint scan & regression test synthesis
                        </div>
                        <button class="btn-launch-large" onclick="launchVerificationFlow()">
                            <span>⚡</span> Start Closed-Loop Verification Pipeline →
                        </button>
                    </div>
                </div>

                <!-- Suggestion Toolbox & Active Rule Cards -->
                <div class="toolbox-card">
                    <div class="toolbox-header">
                        <h3><span>🧰</span> Smart Security Toolbox & Rules</h3>
                        <p>Real-time detection status for the code currently in your editor</p>
                    </div>

                    <!-- Active Rules (Dynamically Highlighted) -->
                    <div class="rule-card" id="ruleCardSqli">
                        <div class="rule-card-header">
                            <span class="rule-name">CWE-89: SQL Injection</span>
                            <span class="pill pill-cwe" id="ruleStatusSqli">Active Rule</span>
                        </div>
                        <p class="rule-desc">Flags string formatting reaching cursor.execute(). Recommends database-driver parameterized queries.</p>
                    </div>

                    <div class="rule-card" id="ruleCardCmdi">
                        <div class="rule-card-header">
                            <span class="rule-name">CWE-78: OS Command Injection</span>
                            <span class="pill pill-cwe" id="ruleStatusCmdi">Active Rule</span>
                        </div>
                        <p class="rule-desc">Flags subprocess.run(..., shell=True). Recommends direct argument vectors (shell=False) + regex allowlist.</p>
                    </div>

                    <div class="rule-card" id="ruleCardPath">
                        <div class="rule-card-header">
                            <span class="rule-name">CWE-22: Path Traversal</span>
                            <span class="pill pill-cwe" id="ruleStatusPath">Active Rule</span>
                        </div>
                        <p class="rule-desc">Flags unsanitized file paths. Recommends werkzeug safe_join() + canonical realpath prefix boundaries.</p>
                    </div>

                    <!-- Canary Oracle Toolbox -->
                    <div class="suggestion-box">
                        <h4><span>🎯</span> Canary Oracle Engine</h4>
                        <p>Secret canary tokens (e.g. <code>PP_CANARY_SQLI_*</code>) are dynamically seeded into generated pytest tests. If the canary leaks in the response body, exploitability is mathematically confirmed.</p>
                    </div>

                    <div class="suggestion-box">
                        <h4><span>⚔️</span> Mutation Testing Protection</h4>
                        <p>Prevents naive developer blacklists (like removing only ';' or '--'). Near-miss mutants are automatically injected to verify test suite bypass resistance.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ====================================================================
             VIEW 2: REAL-TIME MOTION PIPELINE STEPPER
             ==================================================================== -->
        <section id="view-motion" class="view-panel">
            <div class="motion-panel">
                <div class="motion-header">
                    <div class="motion-title">
                        <h2><span>⚡</span> Closed-Loop Verification Pipeline</h2>
                        <p id="motionSubStatus">Initializing Semgrep taint analysis & AST entrypoint triage...</p>
                    </div>
                    <span id="motionMainBadge" class="pill pill-cwe">Executing Pipeline...</span>
                </div>

                <!-- 7-Stage Motion Stepper -->
                <div class="motion-stepper">
                    <div class="m-step active" id="mstep-1">
                        <div class="m-step-icon">📡</div>
                        <div class="m-step-name">1. Scan</div>
                        <div class="m-step-badge">Running</div>
                    </div>
                    <div class="m-step" id="mstep-2">
                        <div class="m-step-icon">🗺️</div>
                        <div class="m-step-name">2. Triage</div>
                        <div class="m-step-badge">Waiting</div>
                    </div>
                    <div class="m-step" id="mstep-3">
                        <div class="m-step-icon">📝</div>
                        <div class="m-step-name">3. Generate</div>
                        <div class="m-step-badge">Waiting</div>
                    </div>
                    <div class="m-step" id="mstep-4">
                        <div class="m-step-icon">🔴</div>
                        <div class="m-step-name">4. Red Run</div>
                        <div class="m-step-badge">Waiting</div>
                    </div>
                    <div class="m-step" id="mstep-5">
                        <div class="m-step-icon">🔧</div>
                        <div class="m-step-name">5. Fix</div>
                        <div class="m-step-badge">Waiting</div>
                    </div>
                    <div class="m-step" id="mstep-6">
                        <div class="m-step-icon">🟢</div>
                        <div class="m-step-name">6. Verify</div>
                        <div class="m-step-badge">Waiting</div>
                    </div>
                    <div class="m-step" id="mstep-7">
                        <div class="m-step-icon">📊</div>
                        <div class="m-step-name">7. Report</div>
                        <div class="m-step-badge">Waiting</div>
                    </div>
                </div>

                <!-- Motion Terminal Stream Output -->
                <div class="motion-console-card">
                    <div class="console-topbar">
                        <div style="display: flex; gap: 0.4rem; align-items: center;">
                            <span style="width: 10px; height: 10px; border-radius: 50%; background: #ef4444;"></span>
                            <span style="width: 10px; height: 10px; border-radius: 50%; background: #f59e0b;"></span>
                            <span style="width: 10px; height: 10px; border-radius: 50%; background: #10b981;"></span>
                            <span style="font-size: 0.75rem; color: #94a3b8; font-weight: 600; margin-left: 0.5rem;">Pipeline Execution Engine</span>
                        </div>
                        <span id="motionLiveBadge" class="pill pill-fixed" style="font-size: 0.7rem;">LIVE STREAM</span>
                    </div>
                    <div class="console-stream" id="motionStreamText">Starting PatchProof pipeline engine...</div>
                </div>

                <!-- Completion & Propagation Banner -->
                <div class="motion-completion-card" id="motionCompletionCard">
                    <div>
                        <h3 id="motionCompletionTitle" style="font-size: 1.25rem; font-weight: 800; color: #34d399; margin-bottom: 0.35rem;">
                            🎉 Pipeline Complete!
                        </h3>
                        <p id="motionCompletionDesc" style="font-size: 0.9rem; color: var(--text-muted);">
                            Verification completed.
                        </p>
                    </div>
                    <button class="btn-launch-large" onclick="switchMainTab('reports', document.querySelectorAll('.nav-tabs .tab-btn')[2])">
                        📊 Open Full Evidence Report & Analysis →
                    </button>
                </div>
            </div>
        </section>

        <!-- ====================================================================
             VIEW 3: REPORT & EVIDENCE ANALYSIS (DYNAMICALLY ADAPTIVE DASHBOARD)
             ==================================================================== -->
        <section id="view-reports" class="view-panel">
            <!-- Dynamic Clean Code Banner (shown when 0 findings) -->
            <div id="cleanCodeBanner" style="display: none; background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(6, 182, 212, 0.1)); border: 1px solid var(--accent-green); border-radius: 14px; padding: 2rem; margin-bottom: 2rem; text-align: center;">
                <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🛡️✨</div>
                <h3 style="font-size: 1.5rem; font-weight: 800; color: #34d399; margin-bottom: 0.4rem;">Codebase Clean & Verified!</h3>
                <p style="font-size: 0.95rem; color: var(--text-muted); max-width: 600px; margin: 0 auto 1.25rem;">
                    PatchProof scanned your uploaded code against all active Semgrep taint rules and found <strong>0 security vulnerabilities</strong>. No unsafe sinks or untrusted dataflow paths were identified.
                </p>
                <button class="btn-action" onclick="switchMainTab('studio', document.querySelectorAll('.nav-tabs .tab-btn')[0])">
                    ✏️ Edit Code in Studio
                </button>
            </div>

            <!-- Dynamic KPI Metrics -->
            <div class="kpi-grid" id="reportsKpiGrid">
                <div class="kpi-card purple">
                    <div class="kpi-label">
                        <span>Total Detected</span>
                        <span>🔍</span>
                    </div>
                    <div class="kpi-val" id="kpiTotalFindings">3</div>
                    <div class="kpi-sub" id="kpiTotalSub">Semgrep Taint Detections</div>
                </div>

                <div class="kpi-card red">
                    <div class="kpi-label">
                        <span>Exploits Proven (Red)</span>
                        <span>🔴</span>
                    </div>
                    <div class="kpi-val" id="kpiRedProven">3 / 3</div>
                    <div class="kpi-sub">Canary Leak Confirmation</div>
                </div>

                <div class="kpi-card green">
                    <div class="kpi-label">
                        <span>Verified Fixes (Green)</span>
                        <span>🟢</span>
                    </div>
                    <div class="kpi-val" id="kpiGreenVerified">3 / 3</div>
                    <div class="kpi-sub">Clean Rescan & Tests Pass</div>
                </div>

                <div class="kpi-card amber">
                    <div class="kpi-label">
                        <span>Mutants Killed</span>
                        <span>⚔️</span>
                    </div>
                    <div class="kpi-val" id="kpiMutantsKilled">3 / 3</div>
                    <div class="kpi-sub">Near-Miss Sensitivity Score (100%)</div>
                </div>
            </div>

            <!-- Vulnerability Findings Matrix -->
            <div class="card-panel" id="reportsMatrixPanel">
                <div class="panel-header">
                    <h2><span>📋</span> Vulnerabilities Matrix & Verification Evidence</h2>
                    <div class="table-filter-bar">
                        <input type="text" class="search-box" id="matrixSearch" placeholder="Filter findings..." oninput="filterTable()">
                    </div>
                </div>
                <div style="overflow-x: auto;">
                    <table id="findingsTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Vulnerability</th>
                                <th>CWE</th>
                                <th>Entrypoint Route</th>
                                <th>Red Run (Proof)</th>
                                <th>Green Run</th>
                                <th>Scanner Rescan</th>
                                <th>Sensitivity</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="findingsTableBody">
                            <!-- Populated dynamically by JS matching uploaded code -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Master-Detail Explorer -->
            <div class="card-panel" id="reportsExplorerPanel">
                <div class="panel-header">
                    <h2><span>🛡️</span> Deep-Dive Findings & Explainable Fixes Explorer</h2>
                </div>
                <div style="padding: 1.5rem;">
                    <div class="explorer-layout">
                        <!-- Left Sidebar: Vulnerabilities Picker -->
                        <div class="vuln-list" id="vulnSelectorList">
                            <!-- Populated dynamically by JS -->
                        </div>

                        <!-- Right Detail Cards -->
                        <div id="vulnDetailContainer">
                            <!-- Populated dynamically by JS -->
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ====================================================================
             VIEW 4: ATTACK & FIX SIMULATOR
             ==================================================================== -->
        <section id="view-simulator" class="view-panel">
            <div class="card-panel">
                <div class="panel-header">
                    <h2><span>🧪</span> Interactive Vulnerability & Fix Simulation Sandbox</h2>
                </div>
                <div style="padding: 1.5rem;">
                    <div class="sim-grid">
                        <div>
                            <div class="form-group">
                                <label class="form-label">1. Select Target Vulnerability</label>
                                <select class="form-select" id="simVulnSelect" onchange="onSimVulnChange()">
                                    <option value="sqli">CWE-89: SQL Injection (/search?q=)</option>
                                    <option value="cmdi">CWE-78: Command Injection (/ping?host=)</option>
                                    <option value="pathtraversal">CWE-22: Path Traversal (/download?file=)</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label class="form-label">2. Select Application Code State</label>
                                <div class="radio-group">
                                    <div class="radio-card active" onclick="setSimState('vuln', this)">
                                        <div class="radio-title">🔴 Vulnerable</div>
                                        <div class="radio-desc">Unpatched app</div>
                                    </div>
                                    <div class="radio-card" onclick="setSimState('mutant', this)">
                                        <div class="radio-title">🟡 Naive Fix</div>
                                        <div class="radio-desc">Weak mutant blacklist</div>
                                    </div>
                                    <div class="radio-card" onclick="setSimState('fixed', this)">
                                        <div class="radio-title">🟢 Secure Fix</div>
                                        <div class="radio-desc">PatchProof patch</div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="form-label">3. Select or Type Attack Payload</label>
                                <select class="form-select" id="simPresetPayload" onchange="onSimPresetChange()" style="margin-bottom: 0.5rem;">
                                </select>
                                <input type="text" class="form-input" id="simCustomPayload" placeholder="Enter custom attack payload...">
                            </div>

                            <button class="btn-launch-sim" onclick="runAttackSimulation()">
                                🚀 Execute Simulated Request
                            </button>
                        </div>

                        <div>
                            <label class="form-label">Simulation Console & Canary Oracle Evaluation</label>
                            <div class="sim-result-card" id="simResultBox">
                                <div>
                                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; margin-bottom: 0.75rem;">
                                        <span style="font-size: 0.8rem; font-weight: 700; color: var(--accent-blue);">HTTP SERVER SIMULATOR</span>
                                        <span id="simStatusCode" class="pill pill-tag">Status: Ready</span>
                                    </div>

