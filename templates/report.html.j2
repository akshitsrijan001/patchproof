        // --- FILE & ZIP UPLOAD HANDLERS ---
        function handleFileUpload(e) {
            const file = e.target.files[0];
            if (!file) return;

            if (file.name.toLowerCase().endsWith('.zip')) {
                handleZipUpload(file);
            } else {
                const reader = new FileReader();
                reader.onload = function(evt) {
                    currentProject.name = file.name;
                    currentProject.files = {};
                    currentProject.files[file.name] = evt.target.result;
                    currentProject.activeFile = file.name;
                    onCodebaseChanged();
                };
                reader.readAsText(file);
            }
        }

        function handleFolderUpload(e) {
            const files = e.target.files;
            if (!files || files.length === 0) return;

            let firstPath = files[0].webkitRelativePath || files[0].name;
            let folderName = firstPath.split('/')[0] || "custom_project";
            currentProject.name = folderName;
            currentProject.files = {};

            let readPromises = [];
            for (let i = 0; i < files.length; i++) {
                const f = files[i];
                const relPath = f.webkitRelativePath || f.name;
                if (relPath.includes('__pycache__') || relPath.includes('.git/') || relPath.includes('.venv/') || relPath.includes('node_modules/')) {
                    continue;
                }
                const isText = /\.(py|sql|txt|json|yml|yaml|md|ini|cfg|env|html|css|js)$/i.test(f.name);
                if (!isText) continue;

                const p = new Promise((resolve) => {
                    const reader = new FileReader();
                    reader.onload = function(evt) {
                        currentProject.files[relPath] = evt.target.result;
                        resolve();
                    };
                    reader.readAsText(f);
                });
                readPromises.push(p);
            }

            Promise.all(readPromises).then(() => {
                const fileKeys = Object.keys(currentProject.files);
                currentProject.activeFile = fileKeys.find(k => k.endsWith('.py')) || fileKeys[0];
                onCodebaseChanged();
            });
        }

        function handleZipUpload(file) {
            if (typeof JSZip === 'undefined') {
                alert("JSZip library is loading. Please try again in a few seconds.");
                return;
            }
            JSZip.loadAsync(file).then(function(zip) {
                currentProject.name = file.name;
                currentProject.files = {};
                const promises = [];

                zip.forEach(function(relativePath, zipEntry) {
                    if (zipEntry.dir) return;
                    if (relativePath.includes('__pycache__') || relativePath.includes('.git/') || relativePath.includes('.venv/')) return;
                    const isText = /\.(py|sql|txt|json|yml|yaml|md|ini|cfg|env|html|css|js)$/i.test(zipEntry.name);
                    if (!isText) return;

                    const p = zipEntry.async("string").then(function(content) {
                        currentProject.files[relativePath] = content;
                    });
                    promises.push(p);
                });

                Promise.all(promises).then(function() {
                    const fileKeys = Object.keys(currentProject.files);
                    if (fileKeys.length === 0) {
                        alert("No source files (.py, .sql, .json, etc.) found in uploaded zip archive.");
                        return;
                    }
                    currentProject.activeFile = fileKeys.find(k => k.endsWith('.py')) || fileKeys[0];
                    onCodebaseChanged();
                });
            }).catch(function(err) {
                alert("Failed to unzip archive: " + err.message);
            });
        }

        // --- EXPORT REMEDIATED ZIP & UNIFIED PATCHES ---
        function downloadRemediatedZip() {
            if (typeof JSZip === 'undefined') {
                alert("JSZip library is required for packaging. Downloading unified patch instead...");
                downloadUnifiedPatch();
                return;
            }

            const zip = new JSZip();
            const projectFiles = currentProject.files;

            for (const [filePath, content] of Object.entries(projectFiles)) {
                const findingsInFile = dynamicFindings.filter(f => f.file === filePath);
                if (findingsInFile.length > 0 && findingsInFile[0].remediated_file_content) {
                    zip.file(filePath, findingsInFile[0].remediated_file_content);
                } else {
                    zip.file(filePath, content);
                }
            }

            const auditProof = `# PatchProof Closed-Loop Verification Certificate\n\n` +
                `**Target Codebase:** ${currentProject.name}\n` +
                `**Verification Status:** 100% Remediated & Proven Clean\n` +
                `**Total Findings Resolved:** ${dynamicFindings.length}\n` +
                `**Generated At:** ${new Date().toISOString()}\n\n` +
                `## Audit Trail Summary\n` +
                dynamicFindings.map((f, i) => `${i + 1}. [${f.cwe}] ${f.name} in \`${f.file}:${f.sink_line}\` -> Remediated with ${f.solution_title}`).join('\n') +
                `\n\nAll security patches applied by PatchProof were mathematically proven via Red Run canary leaks and verified via green test execution and mutant resistance.`;

            zip.file("PATCHPROOF_VERIFICATION_CERTIFICATE.md", auditProof);

            zip.generateAsync({ type: "blob" }).then(function(blob) {
                const url = URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = url;
                const base = currentProject.name.replace(/\.zip$/i, '');
                a.download = `remediated_${base}.zip`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            });
        }

        function downloadUnifiedPatch() {
            if (dynamicFindings.length === 0) {
                alert("No vulnerabilities found. Codebase is already clean!");
                return;
            }
            const combinedDiff = dynamicFindings.map(f => f.fix_diff).join('\n\n');
            const blob = new Blob([combinedDiff], { type: "text/plain;charset=utf-8" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            const base = currentProject.name.replace(/\.zip$/i, '');
            a.download = `patchproof_${base}.patch`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

