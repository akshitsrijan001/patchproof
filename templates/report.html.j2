                    } else if (i === item.step) {
                        el.className = 'm-step active';
                        el.querySelector('.m-step-badge').textContent = item.badge;
                    } else {
                        el.className = 'm-step';
                        el.querySelector('.m-step-badge').textContent = 'Waiting';
                    }
                }

                // Append log with typewriter style
                stream.textContent += item.log;
                stream.scrollTop = stream.scrollHeight;

                curIndex++;
            }

            advanceMotion();
            motionInterval = setInterval(advanceMotion, 850);
        }

        // --- MASTER-DETAIL REPORT EXPLORER ---
        function selectFinding(index, btn) {
            document.querySelectorAll('.vuln-item').forEach(i => i.classList.remove('selected'));
            document.querySelectorAll('.finding-detail-card').forEach(c => c.style.display = 'none');
            
            btn.classList.add('selected');
            const card = document.getElementById('detail-card-' + index);
            if (card) card.style.display = 'block';
        }

        function openDetailView(index) {
            switchMainTab('reports', document.querySelectorAll('.nav-tabs .tab-btn')[2]);
            const items = document.querySelectorAll('.vuln-item');
            if (items[index]) selectFinding(index, items[index]);
            window.scrollTo({ top: 600, behavior: 'smooth' });
        }

        function switchDetailSubTab(findingIndex, subTabId, btn) {
            const card = document.getElementById('detail-card-' + findingIndex);
            if (!card) return;
            card.querySelectorAll('.detail-tab-btn').forEach(b => b.classList.remove('active'));
            card.querySelectorAll('.detail-tab-pane').forEach(p => p.classList.remove('active'));
            
            btn.classList.add('active');
            const pane = document.getElementById('pane-' + findingIndex + '-' + subTabId);
            if (pane) pane.classList.add('active');
        }

        function filterTable() {
            const query = document.getElementById('matrixSearch').value.toLowerCase();
            const rows = document.querySelectorAll('#findingsTable tbody tr');
            rows.forEach(r => {
                const text = r.textContent.toLowerCase();
                r.style.display = text.includes(query) ? '' : 'none';
            });
        }

        function copyPatch(elementId) {
            const el = document.getElementById(elementId);
            if (!el) return;
            navigator.clipboard.writeText(el.innerText).then(() => {
                alert("Unified Git Patch copied to clipboard!");
            });
        }

        function toggleTheme() {
            document.documentElement.classList.toggle('light');
            document.documentElement.classList.toggle('dark');
        }

        // --- SIMULATOR LOGIC ---
        let currentSimState = 'vuln';
        const simPayloads = {
            sqli: [
                { label: "Legitimate: alice", val: "alice" },
                { label: "Exploit: ' OR '1'='1' --", val: "' OR '1'='1' --" },
                { label: "Bypass: ' OR '1'='1' /*", val: "' OR '1'='1' /*" },
                { label: "Union: x' UNION SELECT name, role FROM users --", val: "x' UNION SELECT name, role FROM users --" }
            ],
            cmdi: [
                { label: "Legitimate: 127.0.0.1", val: "127.0.0.1" },
                { label: "Exploit: 127.0.0.1; echo PP_CANARY_CMDI", val: "127.0.0.1; echo PP_CANARY_CMDI" },
                { label: "Bypass: $(echo PP_CANARY_CMDI)", val: "$(echo PP_CANARY_CMDI)" },
                { label: "Pipe: 127.0.0.1 | echo PP_CANARY_CMDI", val: "127.0.0.1 | echo PP_CANARY_CMDI" }
            ],
            pathtraversal: [
                { label: "Legitimate: readme.txt", val: "readme.txt" },
                { label: "Exploit: ../../secrets/secret.txt", val: "../../secrets/secret.txt" },
                { label: "Bypass: ....//secrets/secret.txt", val: "....//secrets/secret.txt" },
                { label: "Nested: ..\\..\\secrets\\secret.txt", val: "..\\..\\secrets\\secret.txt" }
            ]
        };

        function onSimVulnChange() {
            const v = document.getElementById('simVulnSelect').value;
            const select = document.getElementById('simPresetPayload');
            select.innerHTML = '';
            simPayloads[v].forEach(p => {
                const opt = document.createElement('option');
                opt.value = p.val;
                opt.textContent = p.label;
                select.appendChild(opt);
            });
            onSimPresetChange();
        }

        function onSimPresetChange() {
            document.getElementById('simCustomPayload').value = document.getElementById('simPresetPayload').value;
        }

        function setSimState(state, card) {
            currentSimState = state;
            document.querySelectorAll('.radio-card').forEach(c => c.classList.remove('active'));
            card.classList.add('active');
        }

        function runAttackSimulation() {
            const vuln = document.getElementById('simVulnSelect').value;
            const payload = document.getElementById('simCustomPayload').value || 'test';
            const state = currentSimState;

            const reqLine = document.getElementById('simRequestLine');
            const execCode = document.getElementById('simExecutionCode');
            const respBody = document.getElementById('simResponseBody');
            const statusCode = document.getElementById('simStatusCode');
            const verdict = document.getElementById('simVerdictBanner');

            if (vuln === 'sqli') {
                reqLine.textContent = `GET /search?q=${encodeURIComponent(payload)}`;
                if (state === 'vuln') {
                    execCode.textContent = `query = f"SELECT name, role FROM users WHERE name LIKE '%${payload}%'"\ncursor.execute(query)`;
                    if (payload.includes("'") || payload.includes("--")) {
                        statusCode.textContent = "200 OK";
                        statusCode.className = "pill pill-fail";
                        respBody.textContent = JSON.stringify({
                            query: payload,
                            results: [
                                {"name": "alice", "role": "user"},
                                {"name": "bob", "role": "user"},
                                {"name": "PP_CANARY_SQLI_8f2a", "role": "canary"}
                            ]
                        }, null, 2);
                        verdict.style.background = "rgba(244, 63, 94, 0.15)";
                        verdict.style.color = "#f43f5e";
                        verdict.style.borderColor = "rgba(244, 63, 94, 0.4)";
                        verdict.textContent = "🚨 EXPLOIT SUCCESSFUL! Secret canary 'PP_CANARY_SQLI_8f2a' leaked. (Red Run Confirmed)";
                    } else {
                        statusCode.textContent = "200 OK";
                        statusCode.className = "pill pill-pass";
                        respBody.textContent = JSON.stringify({ query: payload, results: [{"name": "alice", "role": "user"}] }, null, 2);
                        verdict.textContent = "ℹ️ Normal search result returned.";
                    }
                } else if (state === 'mutant') {
                    const filtered = payload.replace(/--/g, '');
                    execCode.textContent = `# MUTANT: q_filtered = q.replace('--', '')\nquery = f"SELECT ... '%${filtered}%'"\ncursor.execute(query)`;
                    if (payload.includes("/*") || (payload.includes("'") && !payload.includes("--"))) {
                        statusCode.textContent = "200 OK";
                        statusCode.className = "pill pill-fail";
                        respBody.textContent = JSON.stringify({
                            query: payload,
                            results: [
                                {"name": "alice", "role": "user"},
                                {"name": "bob", "role": "user"},
                                {"name": "PP_CANARY_SQLI_8f2a", "role": "canary"}
                            ]
                        }, null, 2);
                        verdict.style.background = "rgba(245, 158, 11, 0.15)";
                        verdict.style.color = "#f59e0b";
                        verdict.style.borderColor = "rgba(245, 158, 11, 0.4)";
                        verdict.textContent = "⚠️ BYPASS DETECTED! Naive '--' filter bypassed with inline syntax. Mutant KILLED by PatchProof.";
                    } else {
                        statusCode.textContent = "200 OK";
                        respBody.textContent = `{"query": "${payload}", "results": []}`;
                        verdict.textContent = "Naive filter stopped standard payload, but vulnerable to bypass.";
                    }
                } else {
                    execCode.textContent = `# FIXED: cursor.execute("SELECT name, role FROM users WHERE name LIKE ?", (f"%{q}%",))`;
                    statusCode.textContent = "200 OK";
                    statusCode.className = "pill pill-pass";
                    respBody.textContent = JSON.stringify({ query: payload, results: [] }, null, 2);
                    verdict.style.background = "rgba(16, 185, 129, 0.15)";
                    verdict.style.color = "#10b981";
                    verdict.style.borderColor = "rgba(16, 185, 129, 0.4)";
                    verdict.textContent = "🛡️ ATTACK BLOCKED! Parameterized query treated input as literal string. Canary safe.";
                }
            } else if (vuln === 'cmdi') {
                reqLine.textContent = `GET /ping?host=${encodeURIComponent(payload)}`;
                if (state === 'vuln') {
                    execCode.textContent = `cmd = f"ping -c 1 ${payload}"\nsubprocess.run(cmd, shell=True)`;
                    if (payload.includes(";") || payload.includes("$") || payload.includes("|") || payload.includes("&&")) {
                        statusCode.textContent = "200 OK";
                        statusCode.className = "pill pill-fail";
                        respBody.textContent = JSON.stringify({
                            host: payload,
                            stdout: "PING 127.0.0.1 (127.0.0.1) 56(84) bytes\nPP_CANARY_CMDI\n"
                        }, null, 2);
                        verdict.style.background = "rgba(244, 63, 94, 0.15)";
                        verdict.style.color = "#f43f5e";
                        verdict.style.borderColor = "rgba(244, 63, 94, 0.4)";
                        verdict.textContent = "🚨 EXPLOIT SUCCESSFUL! Shell injected command executed canary: 'PP_CANARY_CMDI'.";
                    } else {
                        statusCode.textContent = "200 OK";
                        respBody.textContent = JSON.stringify({ host: payload, stdout: "Reply from 127.0.0.1: bytes=32 time<1ms" }, null, 2);
                        verdict.textContent = "Standard ping response.";
                    }
                } else if (state === 'mutant') {
                    execCode.textContent = `# MUTANT: if ';' in host: return 400\ncmd = f"ping {payload}"\nsubprocess.run(cmd, shell=True)`;
                    if (payload.includes(";") && !payload.includes("$") && !payload.includes("|")) {
                        statusCode.textContent = "400 Bad Request";
                        statusCode.className = "pill pill-pass";
                        respBody.textContent = '{"error": "Invalid host"}';
                        verdict.textContent = "Blocked semicolon, but test checks $(cmd) bypass.";
                    } else if (payload.includes("$") || payload.includes("|")) {
                        statusCode.textContent = "200 OK";
                        statusCode.className = "pill pill-fail";
                        respBody.textContent = JSON.stringify({ host: payload, stdout: "PP_CANARY_CMDI\n" }, null, 2);
                        verdict.style.background = "rgba(245, 158, 11, 0.15)";
                        verdict.style.color = "#f59e0b";
                        verdict.style.borderColor = "rgba(245, 158, 11, 0.4)";
                        verdict.textContent = "⚠️ BYPASS DETECTED! Semicolon blacklist defeated via $() command substitution. Mutant KILLED.";
                    }
                } else {
                    execCode.textContent = `# FIXED: re.match(r'^[a-zA-Z0-9.-]+$', host) and subprocess.run(['ping', host], shell=False)`;
                    if (/^[a-zA-Z0-9.\-]+$/.test(payload)) {
                        statusCode.textContent = "200 OK";
                        statusCode.className = "pill pill-pass";
                        respBody.textContent = JSON.stringify({ host: payload, stdout: "Ping successful." }, null, 2);
                        verdict.style.background = "rgba(16, 185, 129, 0.15)";
                        verdict.style.color = "#10b981";
                        verdict.style.borderColor = "rgba(16, 185, 129, 0.4)";
                        verdict.textContent = "🛡️ Valid host executed safely with shell=False. Injections impossible.";
                    } else {
                        statusCode.textContent = "400 Bad Request";
                        statusCode.className = "pill pill-pass";
                        respBody.textContent = '{"error": "Invalid host"}';
                        verdict.style.background = "rgba(16, 185, 129, 0.15)";
                        verdict.style.color = "#10b981";
                        verdict.style.borderColor = "rgba(16, 185, 129, 0.4)";
                        verdict.textContent = "🛡️ ATTACK BLOCKED! Strict regex rejected unvalidated host with HTTP 400.";
                    }
                }
            } else if (vuln === 'pathtraversal') {
                reqLine.textContent = `GET /download?file=${encodeURIComponent(payload)}`;
                if (state === 'vuln') {
                    execCode.textContent = `filepath = os.path.join(PUBLIC_DIR, filename)\nreturn send_file(filepath)`;
                    if (payload.includes("..")) {
                        statusCode.textContent = "200 OK";
                        statusCode.className = "pill pill-fail";
                        respBody.textContent = "PP_CANARY_PATHTRAVERSAL_3d7b\n";
                        verdict.style.background = "rgba(244, 63, 94, 0.15)";
                        verdict.style.color = "#f43f5e";
                        verdict.style.borderColor = "rgba(244, 63, 94, 0.4)";
                        verdict.textContent = "🚨 EXPLOIT SUCCESSFUL! Arbitrary file read exposed 'PP_CANARY_PATHTRAVERSAL_3d7b'.";
                    } else {
                        statusCode.textContent = "200 OK";
                        respBody.textContent = "This is a public file.\n";
                        verdict.textContent = "Public file read.";
                    }
                } else if (state === 'mutant') {
                    const stripped = payload.replace(/\.\.\//g, '');
                    execCode.textContent = `# MUTANT: filename.replace('../', '')\nfilepath = os.path.join(PUBLIC_DIR, "${stripped}")`;
                    if (payload.includes("....//")) {
                        statusCode.textContent = "200 OK";
                        statusCode.className = "pill pill-fail";
                        respBody.textContent = "PP_CANARY_PATHTRAVERSAL_3d7b\n";
                        verdict.style.background = "rgba(245, 158, 11, 0.15)";
                        verdict.style.color = "#f59e0b";
                        verdict.style.borderColor = "rgba(245, 158, 11, 0.4)";
                        verdict.textContent = "⚠️ BYPASS DETECTED! '....//' collapsed into '../' after single strip. Mutant KILLED.";
                    } else {
                        statusCode.textContent = "404 Not Found";
                        respBody.textContent = '{"error": "File not found"}';
                        verdict.textContent = "Standard traversal stripped, but vulnerable to nested sequences.";
                    }
                } else {
                    execCode.textContent = `# FIXED: filepath = safe_join(PUBLIC_DIR, filename)\nif not realpath(filepath).startswith(realpath(PUBLIC_DIR)): return 403`;
                    if (payload.includes("..")) {
                        statusCode.textContent = "403 Forbidden";
                        statusCode.className = "pill pill-pass";
                        respBody.textContent = '{"error": "Access denied"}';
                        verdict.style.background = "rgba(16, 185, 129, 0.15)";
                        verdict.style.color = "#10b981";
                        verdict.style.borderColor = "rgba(16, 185, 129, 0.4)";
                        verdict.textContent = "🛡️ ATTACK BLOCKED! safe_join and realpath boundary check returned 403 Forbidden.";
                    } else {
                        statusCode.textContent = "200 OK";
                        statusCode.className = "pill pill-pass";
                        respBody.textContent = "This is a public file.\n";
                        verdict.textContent = "Legitimate public file returned safely.";
                    }
                }
            }
        }

        // Initialize on load
        document.addEventListener('DOMContentLoaded', () => {
            loadPreset('full');
            onSimVulnChange();
        });
    </script>
