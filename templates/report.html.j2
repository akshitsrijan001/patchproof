                else if (path.endsWith('.sql')) icon = '🗄️';
                else if (path.endsWith('.json') || path.endsWith('.yml') || path.endsWith('.yaml') || path.endsWith('.cfg')) icon = '⚙️';
                else if (path.endsWith('.md') || path.endsWith('.txt')) icon = '📝';

