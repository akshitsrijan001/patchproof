                                exploit_payload: `../../secrets/secret.txt`,
                                exploit_mechanism: `Relative path sequences escape root storage directory, exposing secrets to unauthorized clients.`,
                                solution_title: "Path Normalization (safe_join) & Canonical Prefix Check",
                                solution_mechanism: `Enforce path boundary with safe_join and ensure os.path.realpath(target).startswith(os.path.realpath(ARCHIVE_DIR)).`,
                                fix_diff: `--- a/${filePath}\n+++ b/${filePath}\n@@ -${lineNum},4 +${lineNum},8 @@\n+    from werkzeug.utils import safe_join\n+    filepath = safe_join(ARCHIVE_DIR, ${currentParam})\n+    if filepath is None or not os.path.realpath(filepath).startswith(os.path.realpath(ARCHIVE_DIR)):\n+        return jsonify({"error": "Access denied"}), 403\n-    filepath = os.path.join(ARCHIVE_DIR, ${currentParam})\n     return send_file(filepath)`,
                                remediated_file_content: fixedLines.join('\n'),
                                bad_fix_title: "Single-Pass Relative Sequence Stripping (Mutant)",
                                bad_fix_mechanism: "Stripping '../' once fails against nested sequences like '....//', which collapse to '../'.",
                                mutants_killed: [1, 1],
                                test_code: `# Regression test generated by PatchProof for ${filePath}:${currentFunc}\nimport pytest\n\nCANARY = "PP_CANARY_PATHTRAVERSAL_3d7b"\n\n@pytest.mark.parametrize("payload", ["../../secrets/secret.txt", "....//secrets/secret.txt"])\ndef test_${currentParam}_does_not_leak_secret(client, payload):\n    r = client.${currentMethod.toLowerCase()}("${currentRoute}", query_string={"${currentParam}": payload})\n    assert CANARY not in r.get_data(as_text=True)`
                            });
                        }
                    }
                }
            }

            return {
